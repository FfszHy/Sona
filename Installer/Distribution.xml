<?xml version="1.0" encoding="utf-8"?>
<!-- Sona installer. Built by Installer/build-installer.sh; @VERSION@ is substituted there. -->
<installer-gui-script minSpecVersion="2">
    <title>Sona @VERSION@</title>
    <organization>com.sona</organization>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="26.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.sona.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.sona.pkg" visible="false">
        <pkg-ref id="com.sona.pkg"/>
    </choice>
    <pkg-ref id="com.sona.pkg" version="@VERSION@" onConclusion="none">Sona-component.pkg</pkg-ref>
</installer-gui-script>
