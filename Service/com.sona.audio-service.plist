<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sona.audio-service</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/SonaAudioService</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.sona.audio-service</key>
		<true/>
		<key>com.sona.audio-service.status</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
